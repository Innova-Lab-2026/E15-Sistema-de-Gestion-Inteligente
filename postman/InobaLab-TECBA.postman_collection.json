                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Has official epok rubros', function () {",
                  "  var items = pm.response.json();",
                  "  pm.expect(items.length).to.be.at.least(100);",
                  "  pm.expect(items.some(i => i.code === 'rubro_102')).to.be.true;",
                  "  pm.expect(items.some(i => i.epok_rubro_id === 102)).to.be.true;",
