# Application
APP_NAME=InobaLab TECBA API
# local: syncs the catalog on startup. Anything else (default: production) needs an explicit seed.
APP_ENV=local
# true logs every SQL statement
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false
# Requests with a larger Content-Length are rejected with 413
MAX_REQUEST_BYTES=65536
# Per client IP, for /consultations, /interpretations and /locations/* (LLM / USIG / epok)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30

# Database (PostGIS via docker-compose)
DATABASE_URL=postgresql+asyncpg://tecba:tecba@localhost:5432/tecba

# LLM (OpenAI-compatible). If LLM_API_KEY is empty, /interpretations uses local mock rules.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=30

# Outbound HTTP to official sources (USIG, epok): shared client with User-Agent and retries
HTTP_USER_AGENT=Mozilla/5.0 (compatible; InobaLab-TECBA/1.0)
HTTP_TIMEOUT_SECONDS=10
HTTP_RETRIES=2

# Geocoder: usig (real) | mock (local fixtures, offline development only)
GEOCODER_PROVIDER=usig
GEOCODER_BASE_URL=https://servicios.usig.buenosaires.gob.ar
GEOCODER_WS_BASE_URL=https://ws.usig.buenosaires.gob.ar
GEOCODER_TIMEOUT_SECONDS=10

# Ciudad 3D / epok (etapa 3b). EPOK_PROVIDER=mock|epok
EPOK_PROVIDER=epok
EPOK_BASE_URL=https://epok.buenosaires.gob.ar
EPOK_TIMEOUT_SECONDS=15

# BA Data (CKAN) — siempre con User-Agent
BA_DATA_BASE_URL=https://data.buenosaires.gob.ar
BA_DATA_TIMEOUT_SECONDS=30
BA_DATA_USER_AGENT=Mozilla/5.0 (compatible; InobaLab-TECBA/1.0)

# Docker entrypoint (scripts/docker-entrypoint.sh)
RUN_MIGRATIONS=true
RUN_SEED=false
